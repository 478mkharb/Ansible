pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  options {
    timestamps()
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'https://github.com/478mkharb/Ansible.git'
      }
    }

    stage('Terraform Init & Apply') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          sh '''
            set -e
            terraform init
            terraform apply -auto-approve
          '''
        }
      }
    }

    stage('Generate Ansible Inventory') {
      steps {
        dir('oneclick-monitoring-FINAL') {
          script {
            def bastion = sh(
              script: 'cd terraform && terraform output -raw bastion_public_ip',
              returnStdout: true
            ).trim()

            def monitoring = sh(
              script: 'cd terraform && terraform output -json monitoring_private_ips | jq -r ".[]"',
              returnStdout: true
            ).trim()

            def app = sh(
              script: 'cd terraform && terraform output -raw app_private_ip',
              returnStdout: true
            ).trim()

            sh """
              cat > ansible/inventory.ini <<EOF
[_monitoring]
${monitoring}

[_app]
${app}

[all:vars]
ansible_user=ubuntu
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyJump=ubuntu@${bastion}'
EOF
            """

            sh 'cat ansible/inventory.ini'
          }
        }
      }
    }

    stage('Configure Servers (Ansible)') {
      steps {
        dir('oneclick-monitoring-FINAL/ansible') {
          sshagent(['prometheus-key']) {
            sh '''
              set -e
              ansible-playbook -i inventory.ini site.yml
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "🎉 Infrastructure + Configuration completed successfully"
    }
    failure {
      echo "❌ Pipeline failed. Check logs above."
    }
  }
}
