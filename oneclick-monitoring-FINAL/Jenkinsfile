pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    ANSIBLE_HOST_KEY_CHECKING = 'False'
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'git@github.com:478mkharb/Ansible.git'
      }
    }

    stage('Terraform Init & Apply') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          sh '''
            set -e
            terraform init
            terraform apply -auto-approve
          '''
        }
      }
    }

    stage('Fetch Bastion IP') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          script {
            env.BASTION_IP = sh(
              script: 'terraform output -raw bastion_public_ip',
              returnStdout: true
            ).trim()

            echo "✅ Bastion Public IP: ${env.BASTION_IP}"
          }
        }
      }
    }

    stage('Configure Servers (Ansible)') {
      steps {
        dir('oneclick-monitoring-FINAL/ansible') {

          sshagent(['bastion-ssh-key']) {
            sh '''
              set -e

              # SSH MUST hop via bastion (ProxyJump)
              SSH_ARGS="-o StrictHostKeyChecking=no \
                        -o UserKnownHostsFile=/dev/null \
                        -o ProxyJump=ubuntu@${BASTION_IP}"

              echo "🚀 Running Ansible via Bastion ${BASTION_IP}"

              ansible-playbook site.yml \
                -e bastion_ip=${BASTION_IP} \
                --ssh-common-args="$SSH_ARGS"
            '''
          }

        }
      }
    }
  }

  post {
    success {
      echo "🎉 One-Click Monitoring Infrastructure Deployed Successfully"
      echo "🔐 Bastion Host IP: ${env.BASTION_IP}"
      echo "📊 Access Grafana & Prometheus via SSH Port Forwarding"
    }

    failure {
      echo "❌ Pipeline failed. Check logs above."
    }
  }
}
