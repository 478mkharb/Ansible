pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'https://github.com/478mkharb/Ansible.git'
      }
    }

    stage('Terraform Apply') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          sh '''
            terraform init
            terraform apply -auto-approve
          '''
        }
      }
    }

    stage('Fetch Bastion IP') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          script {
            env.BASTION_IP = sh(
              script: 'terraform output -raw bastion_public_ip',
              returnStdout: true
            ).trim()
            echo "Bastion IP: ${env.BASTION_IP}"
          }
        }
      }
    }

    stage('Run Ansible') {
      steps {
        dir('oneclick-monitoring-FINAL/ansible') {
          sshagent(['oneclick']) {
            sh '''
              export ANSIBLE_SSH_COMMON_ARGS="-o ForwardAgent=yes \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              -o ProxyJump=ubuntu@${BASTION_IP}"

              ansible-playbook \
                -i inventory/aws_ec2.yml \
                -u ubuntu \
                site.yml
            '''
          }
        }
      }
    }
  }
}
