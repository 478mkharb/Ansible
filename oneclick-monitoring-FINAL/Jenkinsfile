pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    ANSIBLE_HOST_KEY_CHECKING = 'False'
  }

  options {
    timestamps()
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'https://github.com/478mkharb/Ansible.git'
      }
    }

    stage('Terraform Init & Apply') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          sh '''
            set -e
            terraform init
            terraform apply -auto-approve
          '''
        }
      }
    }

    stage('Fetch Bastion IP') {
      steps {
        dir('oneclick-monitoring-FINAL/terraform') {
          script {
            env.BASTION_IP = sh(
              script: 'terraform output -raw bastion_public_ip',
              returnStdout: true
            ).trim()

            echo "✅ Bastion Public IP: ${env.BASTION_IP}"
          }
        }
      }
    }

    stage('Prepare Ansible Bastion Vars') {
      steps {
        dir('oneclick-monitoring-FINAL/ansible') {
          sh '''
            set -e
            mkdir -p group_vars/all

            cat <<EOF > group_vars/all/bastion.yml
ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyJump=ubuntu@${BASTION_IP}"
EOF

            echo "📄 Generated Ansible bastion vars:"
            cat group_vars/all/bastion.yml
          '''
        }
      }
    }

    stage('Configure Servers (Ansible)') {
      steps {
        dir('oneclick-monitoring-FINAL/ansible') {
          sshagent(['prometheus-key']) {
            sh '''
              set -e
              ansible-playbook site.yml
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "🎉 Infrastructure + Configuration completed successfully"
      echo "🔐 Bastion IP: ${env.BASTION_IP}"
    }
    failure {
      echo "❌ Pipeline failed. Check logs above."
    }
  }
}
