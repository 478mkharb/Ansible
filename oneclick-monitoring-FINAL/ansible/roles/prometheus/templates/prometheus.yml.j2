global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "ec2-node-exporter"

    ec2_sd_configs:
      - region: ap-south-1
        port: 9100
        filters:
          - name: tag:Role
            values:
              - app

    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: $1:9100
