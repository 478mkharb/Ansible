global:
  resolve_timeout: 5m
  {% if slack_webhook != "" %}
  slack_api_url: "{{ slack_webhook }}"
  {% endif %}

route:
  receiver: 'slack-notifications'

receivers:
  - name: 'slack-notifications'
    {% if slack_webhook != "" %}
    slack_configs:
      - channel: '#alerts'
        send_resolved: true
    {% endif %}
