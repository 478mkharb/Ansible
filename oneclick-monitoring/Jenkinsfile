pipeline {
  agent any

  stages {
    stage('Lint') {
      steps {
        sh 'ansible-lint roles/ || true'
      }
    }

    stage('Syntax Check') {
      steps {
        sh 'ansible-playbook deploy.yml --syntax-check'
      }
    }

    stage('Dry Run') {
      steps {
        sh 'ansible-playbook deploy.yml --check'
      }
    }

    stage('Deploy') {
      steps {
        sh 'ansible-playbook deploy.yml'
      }
    }
  }
}
