pipeline {
  agent any

  stages {

    stage('Debug') {
      steps {
        sh '''
          echo "Workspace:"
          pwd
          echo "Repo contents:"
          ls -l
          echo "Find deploy.yml:"
          find . -name deploy.yml
        '''
      }
    }

    stage('Syntax Check') {
      steps {
        sh 'ansible-playbook oneclick-monitoring/deploy.yml --syntax-check'
      }
    }

    stage('Dry Run') {
      steps {
        sh 'ansible-playbook oneclick-monitoring/deploy.yml --check'
      }
    }

    stage('Deploy') {
      steps {
        sh 'ansible-playbook oneclick-monitoring/deploy.yml'
      }
    }

  }
}
